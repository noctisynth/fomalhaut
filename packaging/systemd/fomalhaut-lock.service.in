[Unit]
Description=Fomalhaut Wayland session locker
Documentation=https://github.com/noctisynth/fomalhaut
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=@FOMALHAUT_LOCK@
TimeoutStartSec=0
Restart=no
UnsetEnvironment=GDK_SCALE GDK_DPI_SCALE
# The configured PAM stack may execute a privileged unix_chkpwd-style helper.
NoNewPrivileges=no
