{
  "name": "@fomalhaut/theme-nocturne",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite --config vite-config.ts",
    "build": "tsc -b && vite build --config vite-config.ts && bun run verify-build",
    "check": "biome check . && tsc -b --pretty false && bun run check-file-names",
    "check-file-names": "bun run scripts/check-file-names.mjs",
    "test": "vitest run --config vite-config.ts",
    "verify-build": "bun run scripts/verify-build.mjs",
    "preview": "vite preview --config vite-config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fomalhaut-sdk": "workspace:*",
    "i18next": "^26.3.6",
    "lucide-react": "^1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.11",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
